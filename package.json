{
  "name": "gitmanager",
  "version": "0.3",
  "description": "Git Branch Lifecycle Management & Monitoring Center",
  "main": "./dist/server/index.cjs",
  "author": "GitManager",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build:icon": "node scripts/generate-icon.mjs",
    "smoke": "node scripts/smoke-web.mjs"
  },
  "dependencies": {
    "nodemailer": "^10.0.10",
    "ogl": "^1.0.11",
    "sql.js": "^1.12.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.447.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "zustand": "^4.5.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
